load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

exports_files([
    "README.md",
    "hook_post_install.nsh",
    "hook_pre_install.nsh",
    "hook_pre_uninstall.nsh",
    "options_post_install.nsh",
    "options_pre_uninstall.nsh",
    "test_icon.ico",
])

# Built rather than checked in so the signing tests have a genuine PE
# executable: the duplicate-signing path is only exercised by osslsigncode,
# which is selected by the `.exe` extension that a cc_binary picks up under
# the Windows transition `nsis_installer` applies.
cc_binary(
    name = "dup_service",
    srcs = ["dup_service.cc"],
    visibility = ["//tests:__pkg__"],
)
