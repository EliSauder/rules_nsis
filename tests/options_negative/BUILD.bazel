load("//tests:analysis_tests.bzl", "options_failure_test")

options_failure_test(
    name = "bad_key",
    expected = "must match [a-z][a-z0-9_]*",
    options = [{"name": "o", "key": "Bad-Key"}],
)

options_failure_test(
    name = "reserved_page",
    expected = "page name 'shortcuts' is reserved",
    options = [{"name": "o"}],
    page = {"page_name": "shortcuts"},
)

options_failure_test(
    name = "bad_page_name",
    expected = "page name 'Bad' must match",
    options = [{"name": "o"}],
    page = {"page_name": "Bad"},
)

options_failure_test(
    name = "duplicate_key",
    expected = "duplicate option key 'same'",
    options = [
        {"name": "a", "key": "same"},
        {"name": "b", "key": "same"},
    ],
)

options_failure_test(
    name = "duplicate_key_in_group",
    expected = "duplicate option key 'same'",
    options = [
        {"name": "a", "key": "same"},
        {"name": "b", "key": "same"},
    ],
    groups = [{"name": "g", "options": ["b"]}],
)

options_failure_test(
    name = "enabled_by_not_checkbox",
    expected = "which is a 'text'; it must be a checkbox",
    options = [
        {"name": "a", "control": "text"},
        {"name": "b", "enabled_by": "a"},
    ],
)

options_failure_test(
    name = "enabled_by_other_page",
    expected = "which is not on page",
    options = [
        {"name": "a", "control": "checkbox"},
        {"name": "b", "enabled_by": "a"},
    ],
    items = ["b"],
)

options_failure_test(
    name = "group_enabled_by_child",
    expected = "which is inside the group",
    options = [{"name": "a", "control": "checkbox"}],
    groups = [{"name": "g", "options": ["a"], "enabled_by": "a"}],
)

options_failure_test(
    name = "password_persist_yes",
    expected = "never persisted",
    options = [{"name": "a", "control": "password", "persist": "yes"}],
)

options_failure_test(
    name = "component_page_position",
    expected = "must use position = \"after_components\"",
    options = [{"name": "a"}],
    page = {"position": "after_welcome"},
    component_page = True,
)

options_failure_test(
    name = "unsupported_control",
    expected = "control 'date' is not yet supported",
    options = [{"name": "a", "control": "date"}],
)

options_failure_test(
    name = "wrong_control_attr",
    expected = "attribute 'min' is not used by control 'text'",
    options = [{"name": "a", "min": "1"}],
)

options_failure_test(
    name = "bad_default",
    expected = "is not one of choices",
    options = [{"name": "a", "control": "radio", "choices": ["x", "y"], "default": "z"}],
)

options_failure_test(
    name = "page_overflow",
    expected = "split the options across several pages",
    options = [{"name": "o%d" % i, "control": "text"} for i in range(8)],
)
