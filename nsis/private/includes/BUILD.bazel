load("//nsis/private:dirrule.bzl", "dirrule")

filegroup(
    name = "includes",
    srcs = glob(["**/*.nsh", "*.nsh"])
)

dirrule(
    name = "includes_dir",
    srcs = [":includes"],
    visibility = ["//visibility:public"],
)

# Individual includes are harness sources for the include API tests.
exports_files(
    glob(["*.nsh"]),
    visibility = ["//tests:__subpackages__"],
)
