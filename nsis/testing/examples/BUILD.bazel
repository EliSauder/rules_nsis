load("@rules_python//python:py_test.bzl", "py_test")
load("//nsis/testing:defs.bzl", "nsis_compile_test", "nsis_symbol", "nsis_test_harness")

_EXAMPLES = [
    "macro",
    "definition",
    "shorthand",
    "function",
    "uninstaller",
    "file",
    "logging",
    "registry",
    "inout",
    "corruption",
    "uninstaller_corruption",
    "typed",
    "stack_leak",
    "stack_consume",
    "uninstaller_stack_leak",
    "error_flag",
    "function_order",
    "uninstaller_function_order",
    "defines",
    "condition",
    "statement_condition",
    "constant",
    "on_init",
    "uninstaller_on_init",
]

_DIVMOD = ["in:dividend:int", "in:divisor:int", "out:quotient:int", "out:remainder:int"]

[
    nsis_symbol(
        name = name + "_symbol",
        symbol = symbol,
        kind = kind,
        context = context,
        parameters = parameters,
        invocation = invocation,
    )
    for name, symbol, kind, context, parameters, invocation in [
        ("macro", "Echo", "macro", "installer", ["in:text", "out:result"], ""),
        ("definition", "Answer", "definition", "installer", ["out:result"], "value"),
        ("shorthand", "Echo", "definition", "installer", ["in:text", "out:result"], ""),
        ("function", "Echo", "function", "installer", ["in:text", "out:result"], ""),
        ("uninstaller", "un.Echo", "function", "uninstaller", ["in:text", "out:result"], ""),
        ("file", "CreateFile", "macro", "installer", ["in:path", "out:result"], ""),
        ("logging", "Emit", "macro", "installer", ["in:text"], ""),
        ("registry", "Registry", "macro", "installer", ["in:key", "in:value", "out:result"], ""),
        ("inout", "Append", "macro", "installer", ["inout:value"], ""),
        ("corruption", "CorruptRegisters", "macro", "installer", [], ""),
        ("uninstaller_corruption", "CorruptRegisters", "macro", "uninstaller", [], ""),
        ("typed", "Typed", "macro", "installer", ["inout:number:int", "inout:enabled:bool"], ""),
        ("stack_leak", "LeakStack", "macro", "installer", [], ""),
        ("stack_consume", "ConsumeStack", "macro", "installer", [], ""),
        ("uninstaller_stack_leak", "LeakStack", "macro", "uninstaller", [], ""),
        ("error_flag", "SetErrorFlag", "macro", "installer", ["in:clear:bool"], ""),
        ("function_order", "DivMod", "function", "installer", _DIVMOD, ""),
        ("uninstaller_function_order", "un.DivMod", "function", "uninstaller", _DIVMOD, ""),
        ("condition", "IsEven", "condition", "installer", ["in:value:int", "out:even:bool"], ""),
        ("statement_condition", "IfPositive", "condition", "installer", ["in:value:int", "out:positive:bool"], "statement"),
        ("on_init", "ReadInitValue", "macro", "installer", ["out:value"], ""),
        ("uninstaller_on_init", "ReadInitValue", "macro", "uninstaller", ["out:value"], ""),
    ]
]

# A const operand is compiled into the harness instead of passed at run time.
nsis_symbol(
    name = "constant_symbol",
    symbol = "Echo",
    kind = "macro",
    parameters = ["const:text", "out:result"],
    constants = {"text": '"compiled $\\"in$\\""'},
)

[
    nsis_test_harness(
        name = name + "_harness",
        src = "example.nsh",
        description = ":" + name + "_symbol",
        defines = {"EXAMPLE_INIT": "from " + name} if name.endswith("on_init") else {},
        # .onInit (or un.onInit for uninstaller descriptions) runs before the API.
        on_init = ['StrCpy $_example_init "${EXAMPLE_INIT}"'] if name.endswith("on_init") else [],
        testonly = True,
    )
    for name in _EXAMPLES
]

# Builds example.nsh with nothing but its own !includes.
nsis_compile_test(
    name = "example_compile_test",
    src = "example.nsh",
)

filegroup(
    name = "binaries",
    srcs = [name + "_harness" for name in _EXAMPLES],
    testonly = True,
)

nsis_symbol(
    name = "defines_symbol",
    symbol = "un.Example",
    kind = "definition",
    context = "uninstaller",
    parameters = ["in:second:int", "out:first:bool", "inout:third"],
    invocation = "call",
    defines = {"TEST_MODE": "value with spaces"},
    testonly = True,
)

py_test(
    name = "description_test",
    size = "small",
    srcs = ["description_test.py"],
    args = [
        "$(rlocationpath :defines_symbol)",
        "$(rlocationpath :definition_symbol)",
    ],
    data = [":defines_symbol", ":definition_symbol"],
    deps = ["//nsis/testing", "@rules_python//python/runfiles"],
)

[
    py_test(
        name = name + "_test",
        size = "small",
        srcs = ["example_test.py"],
        main = "example_test.py",
        args = [
            name,
            "$(rlocationpath :" + name + "_harness)",
            "$(rlocationpath :" + name + "_symbol)",
        ],
        data = [":" + name + "_harness", ":" + name + "_symbol"],
        deps = ["//nsis/testing", "@rules_python//python/runfiles"],
        target_compatible_with = ["@platforms//os:windows"],
    )
    for name in _EXAMPLES
]
